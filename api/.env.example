# Local development settings for the API (copy to .env and adjust).
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

DB_HOST=localhost
DB_PORT=3306
DB_USER=reading_tracker
DB_PASSWORD=change_me
DB_NAME=reading_tracker

# Comma-separated browser origins allowed by CORS (empty = same-origin only)
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=0
RATE_LIMIT_PER_MINUTE=300

RUN_MIGRATIONS=true
RUN_SEED=true

# Optional contact (email or URL) sent in the User-Agent to Open Library
OPEN_LIBRARY_CONTACT=
