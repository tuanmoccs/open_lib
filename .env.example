# Copy to .env on the server and fill in real values. Never commit .env.

# Public domain of the app (DNS A record must point to the VPS).
# Caddy issues the HTTPS certificate for it automatically.
# For a local HTTP-only test use: SITE_ADDRESS=:80
SITE_ADDRESS=reading.example.com

# MySQL credentials (use long random values, e.g. `openssl rand -base64 24`)
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=reading_tracker
MYSQL_USER=reading_tracker
MYSQL_PASSWORD=change_me_app

# Optional settings
# HTTP_PORT=80
# HTTPS_PORT=443
# LOG_LEVEL=info
# RATE_LIMIT_PER_MINUTE=300
# RUN_SEED=true
# MYSQL_INNODB_BUFFER_POOL_SIZE=128M
# Contact (email/URL) sent to Open Library in the User-Agent, as they recommend
# OPEN_LIBRARY_CONTACT=
